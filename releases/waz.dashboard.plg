<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name "waz.dashboard">
  <!ENTITY author "WAZ">
  <!ENTITY version "2026.08.31.12">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="file:///boot/config/plugins/waz.dashboard.plg" min="7.2.0" icon="fa-tachometer">
<CHANGES>
### &version; - WAZ System v0.8.0

- Integrates the sticky WAZ Health banner, live collectors, thresholds, local time, and uptime into the dashboard plugin.
- Matches the banner to the System, Workloads, and Storage dark palette.
- Migrates standalone WAZ Health settings and recoverably disables its old plugin manifest to prevent duplicate loaders.
- Imports live Docker groups from FolderView Plus and Unraid's native Docker Organizer, with existing FolderView formats retained as fallbacks.
- Adds compact Workloads and Storage attention rows that identify the exact container, parity, pool, array, disk, temperature, capacity, or telemetry problem.
- Adds a SERVER STATUS header to the left panel and moves its LIVE indicator from the footer to the header.
- Removes redundant physical-location labels from Array rows because the Disk Location section already maps every disk.
- Moves Docker-vdisk used/total capacity into the Workloads summary.
- Removes the redundant Docker-vdisk row from the left System memory section and its snapshot payload.
- Replaces the Health summary with Issues: unhealthy containers plus stopped containers whose last exit code was non-zero.
- Builds folders from supported Docker folder labels when no FolderView configuration file exists.
- Removes the redundant selected-container process list while retaining the permanent Top 4 host-process table.
- Removes all secondary text from the four Workloads summary cells.
- Clarifies Health as passing Docker HEALTHCHECK results versus containers that define a health check.
- Imports Docker folders from FolderView3 and compatible FolderView/FolderView2 configurations, including BOM-prefixed JSON.
- Adds the full-height Workloads center panel with FolderView3-aware Docker folders and remembered selection.
- Opens Unraid's native Docker controls from each container icon while loading selected-container telemetry below.
- Adds selected-container CPU, RAM, network, disk I/O, pool access, GPU attribution, status, sparklines, and mini process details.
- Adds a permanent live Top 4 host-process table with Docker attribution immediately above the selected-container inspector.
- Removes the redundant native System and Docker dashboard tiles without modifying Unraid core files.
- Displays storage capacities using decimal KB/MB/GB/TB units.
- Keeps every normal pool-button border blue while restoring each pool's identity color to its percentage value and top bar.
- Labels the parity devices Parity 1 and Parity 2 and replaces duplicate validity text with last- and next-check timing.
- Calculates the next parity check from Unraid's generated schedule and custom week-of-month setting.
- Restyles normal pool cards with cool-blue borders and values while retaining identity colors only in their top bars.
- Preserves Disk Location geometry while renumbering only usable bays: R360 1-8 and each MD1200 1-12.
- Enlarges Array rows and lets them consume the remaining matched panel height.
- Adds the WAZ Storage right-column panel with compact parity status, remembered pool selectors, live pool members, three physical shelf maps, empty bays, and a permanent dynamic two-column Array table.
- Uses Unraid's cached disk telemetry and Disk Location's saved assignments without waking sleeping drives.
- Synchronizes the Storage panel height to the System panel.
- Displays network download and upload side by side with equal width and distinct colors.
- Adds live RAM, log-filesystem, and Docker-vdisk usage bars to the Memory section.
- Reorders the 3x3 status board into CPU/GPU/Power, RAM/Coolant/HBA 0, and Network/Flow/HBA 1 rows.
- Removes the redundant standalone GPU detail section.
- Keeps GPU load, active process names, and video load in the top status board.
- Increases status, section, core, legend, detail, and footer text sizes.
- Renames Server Power to Rack Power and calculates it from UPS load and nominal output.
- Expands the top status board to a 3x3 system summary.
- Adds coolant flow as its own status tile.
- Adds both HBA temperatures through HBA Viewer's shared cached export API.
- Slightly increases status and section label sizes.
- Consolidates CPU, cooling, and power into the top status board.
- Removes the redundant WAZ System heading, allocation drawer, and thermal strip.
- Removes duplicate headline values from the detail sections for a one-screen layout.
- Increases the entire panel to a readable dashboard scale.
- Reduces both history graphs to two-thirds of their prior height.
- Rebuilds System as a native one-column Unraid dashboard panel.
- Adds live CPU topology, memory, network, power, and cooling telemetry.
- Adds best-effort Intel GPU and video process attribution.
- Replaces 100 ms server polling with one combined snapshot per second.
- Keeps persistent settings during forced rolling updates.
- Replaces the MD1200 Docker controller with a host-native, disabled-by-default control loop and compact header control.
- Shows independent Top and Bottom average fan RPM in Auto mode and offers 20/30/40/50 percent Manual control.
- Blocks serial writes while the old Docker controller is running and distinguishes command writes from SES fan telemetry.
- Backs up the Docker configuration, template, logs, and WAZ controller state to the Back-Up share before migration.
</CHANGES>

<!-- Stop the prior watcher before replacing the RAM-backed runtime tree. -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
set -e

RUNTIME_DIR="/usr/local/emhttp/plugins/waz.dashboard"
CONFIG_DIR="/boot/config/plugins/waz.dashboard"

if [ -x "$RUNTIME_DIR/scripts/stop.sh" ]; then
  "$RUNTIME_DIR/scripts/stop.sh" || true
fi
rm -rf "$RUNTIME_DIR"
mkdir -p "$RUNTIME_DIR" "$CONFIG_DIR"
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/waz.dashboard/assets/css/banner.css">
<INLINE>
<![CDATA[
:root {
  --waz-health-background: #111417;
  --waz-health-raised: #1b2025;
  --waz-health-border: #303840;
  --waz-health-text: #e6edf3;
  --waz-health-muted: #87939f;
  --waz-health-cyan: #22b8f0;
  --waz-health-normal: #35c46a;
  --waz-health-attention: #f2a900;
  --waz-health-fault: #e55454;
  --waz-health-unknown: #87939f;
}

#waz-health-banner.waz-health {
  box-sizing: border-box;
  position: sticky;
  top: var(--waz-health-sticky-top, 0);
  z-index: 100;
  width: 100%;
  min-width: 0;
  min-height: 40px;
  height: auto;
  margin: 0;
  border-top: 1px solid var(--waz-health-border);
  border-bottom: 1px solid var(--waz-health-border);
  background: var(--waz-health-background);
  color: var(--waz-health-text);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  line-height: 1;
  text-transform: uppercase;
}

#waz-health-banner .waz-health__inner {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: clamp(10px, 1.4vw, 24px);
  width: 100%;
  height: 39px;
  padding: 0 clamp(12px, 2vw, 28px);
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-width: none;
  white-space: nowrap;
}

#waz-health-banner .waz-health__issues {
  box-sizing: border-box;
  display: none;
  align-items: center;
  gap: clamp(18px, 2.5vw, 36px);
  min-height: 30px;
  padding: 5px clamp(12px, 2vw, 28px) 6px;
  overflow-x: auto;
  overflow-y: hidden;
  border-top: 1px solid var(--waz-health-border);
  background: #0e1114;
  scrollbar-width: thin;
  white-space: nowrap;
}

#waz-health-banner.waz-health--expanded .waz-health__issues {
  display: flex;
}

#waz-health-banner .waz-health__issue {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--waz-health-muted);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.035em;
  text-transform: none;
}

#waz-health-banner .waz-health__issue strong {
  color: inherit;
  font-size: 10px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

#waz-health-banner .waz-health__inner::-webkit-scrollbar {
  display: none;
}

#waz-health-banner .waz-health__identity {
  flex: 0 0 auto;
  font-weight: 800;
  letter-spacing: 0.12em;
}

#waz-health-banner .waz-health__overall,
#waz-health-banner .waz-health__subsystem,
#waz-health-banner .waz-health__meta,
#waz-health-banner .waz-health__uptime {
  display: inline-flex;
  align-items: center;
}

#waz-health-banner .waz-health__overall {
  flex: 0 0 auto;
  gap: 7px;
}

#waz-health-banner .waz-health__subsystems {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex: 0 1 auto;
  gap: clamp(10px, 1.35vw, 22px);
}

#waz-health-banner .waz-health__subsystem {
  gap: 6px;
  color: var(--waz-health-muted);
}

#waz-health-banner .waz-health__divider {
  flex: 0 0 1px;
  align-self: stretch;
  height: 18px;
  margin: auto 0;
  background: var(--waz-health-border);
}

#waz-health-banner .waz-health__dot {
  box-sizing: border-box;
  display: inline-block;
  flex: 0 0 auto;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--waz-health-unknown);
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--waz-health-unknown) 16%, transparent);
}

#waz-health-banner [data-state="normal"] .waz-health__dot {
  background: var(--waz-health-normal);
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--waz-health-normal) 16%, transparent);
}

#waz-health-banner [data-state="attention"] {
  color: var(--waz-health-attention);
}

#waz-health-banner [data-state="attention"] .waz-health__dot {
  background: var(--waz-health-attention);
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--waz-health-attention) 18%, transparent);
}

#waz-health-banner [data-state="fault"] {
  color: var(--waz-health-fault);
}

#waz-health-banner [data-state="fault"] .waz-health__dot {
  background: var(--waz-health-fault);
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--waz-health-fault) 18%, transparent);
}

#waz-health-banner .waz-health__meta {
  flex: 0 0 auto;
  gap: clamp(12px, 1.3vw, 20px);
  margin-left: 0;
  color: var(--waz-health-muted);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.04em;
}

#waz-health-banner .waz-health__fans {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 9px;
  margin-left: auto;
  color: var(--waz-health-text);
  letter-spacing: 0.045em;
}

#waz-health-banner .waz-health__fans-label,
#waz-health-banner .waz-health__fan-readings {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

#waz-health-banner .waz-health__fan-readings {
  color: var(--waz-health-muted);
  font-size: 11px;
  font-variant-numeric: tabular-nums;
}

#waz-health-banner .waz-health__fans[data-state="attention"] .waz-health__fans-label {
  color: var(--waz-health-attention);
}

#waz-health-banner .waz-health__fans[data-state="fault"] .waz-health__fans-label {
  color: var(--waz-health-fault);
}

#waz-health-banner .waz-health__fans--disabled {
  opacity: 0.58;
}

#waz-health-banner .waz-health__fan-select {
  box-sizing: border-box;
  height: 25px;
  min-width: 72px;
  margin: 0;
  padding: 0 23px 0 8px;
  border: 1px solid var(--waz-health-border);
  border-radius: 3px;
  background: var(--waz-health-raised);
  color: var(--waz-health-text);
  font: inherit;
  font-size: 10px;
  letter-spacing: 0.055em;
  text-transform: uppercase;
}

#waz-health-banner .waz-health__fan-select:focus-visible {
  outline: 2px solid var(--waz-health-cyan);
  outline-offset: 1px;
}

#waz-health-banner .waz-health__fan-select:disabled {
  cursor: not-allowed;
  opacity: 0.65;
}

#waz-health-banner .waz-health__uptime {
  gap: 4px;
}

#waz-health-banner[data-connection="offline"] .waz-health__uptime {
  opacity: 0.55;
}

@supports not (color: color-mix(in srgb, white, black)) {
  :root {
    --waz-health-background: #111417;
    --waz-health-border: #303840;
    --waz-health-muted: #87939f;
  }
}

@media (max-width: 900px) {
  #waz-health-banner .waz-health__inner {
    height: 38px;
  }

  #waz-health-banner .waz-health__divider {
    display: none;
  }

  #waz-health-banner .waz-health__subsystems {
    flex: 0 0 auto;
  }

  #waz-health-banner .waz-health__fan-readings {
    display: none;
  }
}

@media (max-width: 620px) {
  #waz-health-banner .waz-health__inner {
    gap: 14px;
    padding: 0 12px;
  }

  #waz-health-banner .waz-health__identity {
    position: sticky;
    left: 0;
    z-index: 1;
    margin-left: -12px;
    padding: 13px 10px 13px 12px;
    background: var(--waz-health-background);
  }
}

@media (prefers-reduced-motion: reduce) {
  #waz-health-banner * {
    scroll-behavior: auto !important;
  }
}

]]>
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/waz.dashboard/assets/css/storage.css">
<INLINE>
<![CDATA[
#waz-storage-tile {
  --waz-bg: #111417;
  --waz-panel: #1b2025;
  --waz-raised: #22282e;
  --waz-border: #303840;
  --waz-text: #e6edf3;
  --waz-muted: #87939f;
  --waz-cyan: #22b8f0;
  --waz-green: #35c46a;
  --waz-amber: #f2a900;
  --waz-red: #e55454;
  --waz-violet: #a78bfa;
  color: var(--waz-text);
}

#waz-storage-tile > tr > td {
  background: var(--waz-bg);
  border-color: var(--waz-border);
}

.waz-storage,
.waz-storage * {
  box-sizing: border-box;
}

.waz-storage {
  display: flex;
  min-height: 620px;
  flex-direction: column;
  overflow: hidden;
  color: var(--waz-text);
  font-variant-numeric: tabular-nums;
}

.waz-storage-header,
.waz-storage-section-head,
.waz-pool-detail-head,
.waz-storage-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.waz-storage-header {
  padding: 2px 2px 8px;
}

.waz-storage-header b {
  display: block;
  font-size: 15px;
  line-height: 18px;
}

.waz-storage-header small {
  display: block;
  margin-top: 2px;
  color: var(--waz-muted);
  font-size: 11px;
  line-height: 14px;
}

.waz-storage-health {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: var(--waz-green);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .07em;
  white-space: nowrap;
}

.waz-storage-health i,
.waz-disk-state {
  display: inline-block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
}

.waz-disk-state {
  margin-right: 4px;
  color: var(--waz-green);
  vertical-align: 1px;
}

.waz-disk-state.waz-is-sleeping { color: var(--waz-muted); }
.waz-disk-state.waz-is-attention { color: var(--waz-amber); }
.waz-disk-state.waz-is-fault { color: var(--waz-red); }

.waz-storage-health.waz-is-loading { color: var(--waz-muted); }
.waz-storage-health.waz-is-attention { color: var(--waz-amber); }
.waz-storage-health.waz-is-fault { color: var(--waz-red); }

.waz-storage-alert {
  margin-bottom: 8px;
  padding: 6px 8px;
  border: 1px solid rgb(242 169 0 / 38%);
  border-left: 3px solid var(--waz-amber);
  background: rgb(242 169 0 / 8%);
  color: #f4c658;
  font-size: 10.5px;
  font-weight: 700;
  line-height: 14px;
}

.waz-storage-alert.waz-is-fault {
  border-color: rgb(229 84 84 / 42%);
  border-left-color: var(--waz-red);
  background: rgb(229 84 84 / 8%);
  color: #f08080;
}

.waz-storage-alert[hidden] { display: none; }

.waz-storage-section {
  margin-top: 8px;
  padding: 8px;
  border: 1px solid var(--waz-border);
  background: var(--waz-panel);
}

.waz-storage-section:first-of-type { margin-top: 0; }

.waz-storage-section-head {
  min-height: 14px;
}

.waz-storage-section-head b {
  color: var(--waz-muted);
  font-size: 11px;
  letter-spacing: .075em;
  line-height: 14px;
}

.waz-storage-section-head > span {
  color: var(--waz-cyan);
  font-size: 11px;
  font-weight: 700;
  line-height: 14px;
}

.waz-storage-meter,
.waz-disk-meter {
  overflow: hidden;
  background: #0b0d0f;
}

.waz-storage-meter {
  height: 6px;
  margin-top: 6px;
}

.waz-disk-meter { height: 4px; }

.waz-storage-meter i,
.waz-disk-meter i {
  display: block;
  width: 0;
  height: 100%;
  background: var(--disk-color, var(--waz-cyan));
  transition: width .45s ease-out;
}

.waz-parity-body {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(140px, 1.35fr);
  gap: 8px;
  margin-top: 6px;
}

.waz-parity-disks {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 5px;
}

.waz-parity-disk,
.waz-pool-member,
.waz-array-disk {
  position: relative;
  min-width: 0;
  overflow: hidden;
  border: 1px solid rgb(135 147 159 / 17%);
  background: var(--waz-raised);
}

.waz-parity-disk::before,
.waz-pool-member::before,
.waz-array-disk::before,
.waz-bay::before,
.waz-pool-tab::before {
  position: absolute;
  content: '';
  background: var(--disk-color, var(--waz-cyan));
}

.waz-parity-disk::before,
.waz-pool-member::before,
.waz-array-disk::before {
  top: 0;
  bottom: 0;
  left: 0;
  width: 3px;
}

.waz-parity-disk {
  padding: 5px 6px 5px 9px;
}

.waz-parity-disk b,
.waz-pool-member b {
  display: block;
  overflow: hidden;
  color: var(--waz-text);
  font-size: 11.5px;
  line-height: 14px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waz-parity-disk small,
.waz-pool-member small {
  display: block;
  overflow: hidden;
  color: var(--waz-muted);
  font-size: 9.5px;
  line-height: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waz-parity-summary {
  min-width: 0;
  align-self: center;
}

.waz-parity-summary strong,
.waz-parity-summary small {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waz-parity-summary strong {
  color: var(--waz-text);
  font-size: 11.5px;
  line-height: 15px;
}

.waz-parity-summary small {
  margin-top: 2px;
  color: var(--waz-muted);
  font-size: 10px;
  line-height: 13px;
}

.waz-pool-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 5px;
  margin-top: 6px;
}

.waz-pool-tab {
  position: relative;
  min-width: 0;
  padding: 7px 6px 5px;
  overflow: hidden;
  border: 1px solid #34566b;
  background: var(--waz-raised);
  color: var(--waz-text);
  cursor: pointer;
  font: inherit;
  text-align: left;
}

.waz-pool-tab::before {
  top: 0;
  right: 0;
  left: 0;
  height: 2px;
}

.waz-pool-tab:hover,
.waz-pool-tab.waz-selected {
  border-color: var(--waz-cyan);
}

.waz-pool-tab b,
.waz-pool-tab strong,
.waz-pool-tab small {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waz-pool-tab b {
  color: var(--waz-muted);
  font-size: 9.5px;
  letter-spacing: .045em;
  line-height: 12px;
}

.waz-pool-tab strong {
  margin-top: 2px;
  color: var(--disk-color, var(--waz-cyan));
  font-size: 14px;
  line-height: 17px;
}

.waz-pool-tab small {
  color: var(--waz-muted);
  font-size: 9px;
  line-height: 11px;
}

.waz-pool-detail {
  margin-top: 6px;
  padding-top: 6px;
  border-top: 1px solid rgb(135 147 159 / 16%);
}

.waz-pool-detail-head strong {
  color: var(--waz-text);
  font-size: 11px;
}

.waz-pool-detail-head span {
  color: var(--disk-color, var(--waz-cyan));
  font-size: 11px;
  font-weight: 700;
}

.waz-pool-detail > .waz-storage-meter i {
  background: var(--waz-cyan);
}

.waz-pool-tab.waz-is-attention { border-color: var(--waz-amber); }
.waz-pool-tab.waz-is-fault { border-color: var(--waz-red); }

.waz-pool-members {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 5px;
  margin-top: 6px;
}

.waz-pool-member {
  padding: 4px 6px 4px 9px;
  cursor: pointer;
}

.waz-location-groups {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 7px;
  margin-top: 6px;
}

.waz-location-group {
  min-width: 0;
}

.waz-location-group > b {
  display: block;
  margin-bottom: 4px;
  overflow: hidden;
  color: var(--waz-text);
  font-size: 10px;
  line-height: 13px;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waz-location-grid {
  display: grid;
  grid-template-columns: repeat(var(--columns, 5), minmax(0, 1fr));
  gap: 3px;
}

.waz-bay {
  position: relative;
  min-width: 0;
  height: 26px;
  padding: 3px 2px 2px 5px;
  overflow: hidden;
  border: 1px solid var(--waz-border);
  background: #15191d;
  cursor: pointer;
  text-align: center;
}

.waz-bay::before {
  top: 0;
  bottom: 0;
  left: 0;
  width: 3px;
}

.waz-bay.waz-empty {
  cursor: default;
  opacity: .62;
}

.waz-bay.waz-hidden {
  visibility: hidden;
  pointer-events: none;
}

.waz-bay b,
.waz-bay small {
  display: block;
  overflow: hidden;
  line-height: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waz-bay b {
  color: var(--waz-text);
  font-size: 9px;
}

.waz-bay small {
  color: var(--waz-muted);
  font-size: 8px;
}

.waz-is-attention:not(.waz-storage-health) { border-color: var(--waz-amber); }
.waz-is-fault:not(.waz-storage-health) { border-color: var(--waz-red); }
.waz-is-selected { box-shadow: inset 0 0 0 1px var(--waz-cyan); }

.waz-array-section {
  display: flex;
  min-height: 0;
  flex: 1 1 auto;
  flex-direction: column;
}

.waz-array-disks {
  display: grid;
  min-height: 0;
  flex: 1 1 auto;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 4px 6px;
  margin-top: 6px;
  overflow: auto;
  scrollbar-width: thin;
}

.waz-array-column {
  display: grid;
  min-width: 0;
  grid-auto-rows: minmax(28px, 1fr);
  gap: 4px;
}

.waz-array-disk {
  display: grid;
  min-height: 28px;
  grid-template-columns: minmax(70px, 1fr) 38px minmax(64px, 1fr);
  align-items: center;
  gap: 4px;
  padding: 4px 5px 4px 8px;
  cursor: pointer;
  font-size: 11.5px;
  line-height: 14px;
}

.waz-array-disk a {
  overflow: hidden;
  color: var(--waz-text);
  font-weight: 700;
  text-decoration: none;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waz-array-temp {
  overflow: hidden;
  color: var(--waz-muted);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waz-array-temp { text-align: right; }

.waz-array-usage {
  display: grid;
  min-width: 0;
  grid-template-columns: 27px minmax(0, 1fr);
  align-items: center;
  gap: 3px;
  color: var(--waz-text);
  text-align: right;
}

.waz-storage-footer {
  padding: 6px 2px 0;
  color: var(--waz-muted);
  font-size: 10px;
  line-height: 13px;
}

@media (max-width: 620px) {
  .waz-location-groups { grid-template-columns: 1fr; }
  .waz-pool-tabs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .waz-storage { height: auto !important; overflow: visible; }
}


]]>
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/waz.dashboard/assets/css/system.css">
<INLINE>
<![CDATA[
#waz-system-tile {
  --waz-bg: #111417;
  --waz-panel: #1b2025;
  --waz-raised: #22282e;
  --waz-border: #303840;
  --waz-text: #e6edf3;
  --waz-muted: #87939f;
  --waz-cyan: #22b8f0;
  --waz-teal: #2dd4bf;
  --waz-green: #35c46a;
  --waz-amber: #f2a900;
  --waz-red: #e55454;
  --waz-violet: #a78bfa;
  color: var(--waz-text);
}

#waz-system-tile > tr > td {
  background: var(--waz-bg);
  border-color: var(--waz-border);
}

#waz-system-tile .tile-header-main,
#waz-system-tile .section,
#waz-system-tile .section > span {
  color: var(--waz-text);
}

.waz-freshness {
  display: inline-flex;
  align-items: center;
  gap: .38rem;
  color: var(--waz-green);
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .08em;
  white-space: nowrap;
}

.waz-freshness i {
  width: .5rem;
  height: .5rem;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 0 3px rgb(53 196 106 / 12%);
}

.waz-freshness.waz-is-loading { color: var(--waz-muted); }
.waz-freshness.waz-is-stale { color: var(--waz-amber); }
.waz-freshness.waz-is-fault { color: var(--waz-red); }

.waz-system {
  font-variant-numeric: tabular-nums;
  color: var(--waz-text);
}

.waz-system-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 2px 2px 8px;
}

.waz-system-header b {
  display: block;
  font-size: 15px;
  line-height: 18px;
}

.waz-system-header small {
  display: block;
  margin-top: 2px;
  overflow: hidden;
  color: var(--waz-muted);
  font-size: 11px;
  line-height: 14px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waz-system-header .waz-freshness {
  gap: 5px;
  font-size: 10px;
}

.waz-system-header .waz-freshness i {
  width: 6px;
  height: 6px;
  box-shadow: none;
}

.waz-summary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  padding: 1px;
  border: 1px solid var(--waz-border);
  background: var(--waz-border);
}

.waz-summary-cell {
  min-width: 0;
  padding: .58rem .7rem;
  background: var(--waz-panel);
}

.waz-summary-cell span,
.waz-block-header b {
  display: block;
  color: var(--waz-muted);
  font-size: .68rem;
  font-weight: 700;
  letter-spacing: .075em;
  line-height: 1.2;
}

.waz-summary-cell strong {
  display: block;
  margin-top: .16rem;
  overflow: hidden;
  color: var(--waz-cyan);
  font-size: 1rem;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waz-summary-cell.waz-accent-gpu strong { color: var(--waz-violet); }
.waz-summary-cell.waz-accent-cooling strong { color: var(--waz-teal); }
.waz-summary-cell.waz-accent-hba strong { color: var(--waz-teal); }
.waz-summary-cell strong.waz-temp-attention { color: var(--waz-amber); }
.waz-summary-cell strong.waz-temp-fault { color: var(--waz-red); }
.waz-summary-cell strong.waz-temp-unknown { color: var(--waz-muted); }

.waz-summary-cell strong.waz-network-pair {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 6px;
}

.waz-network-pair em {
  min-width: 0;
  overflow: hidden;
  color: var(--waz-cyan);
  font-size: inherit;
  font-style: normal;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waz-network-pair em + em {
  color: var(--waz-violet);
  text-align: right;
}

.waz-block {
  margin-top: .75rem;
  padding: .72rem;
  border: 1px solid var(--waz-border);
  background: var(--waz-panel);
}

.waz-block-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: .75rem;
}

.waz-block-header > span {
  min-width: 0;
}

.waz-block-header small {
  display: block;
  margin-top: .16rem;
  overflow: hidden;
  color: var(--waz-muted);
  font-size: .75rem;
  font-weight: 400;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waz-block-header > strong {
  flex: 0 0 auto;
  color: var(--waz-cyan);
  font-size: 1.16rem;
  line-height: 1.2;
}

.waz-chart-wrap,
.waz-network-chart-wrap {
  position: relative;
  height: 78px;
  margin-top: .55rem;
  overflow: hidden;
  border: 1px solid var(--waz-border);
  background: var(--waz-bg);
}

.waz-chart-wrap > span,
.waz-network-key {
  position: absolute;
  z-index: 1;
  top: .28rem;
  left: .38rem;
  color: var(--waz-muted);
  font-size: .62rem;
  font-weight: 700;
  letter-spacing: .065em;
  pointer-events: none;
}

.waz-chart-wrap svg,
.waz-network-chart-wrap svg {
  display: block;
  width: 100%;
  height: 100%;
}

.waz-chart-wrap line,
.waz-network-chart-wrap line {
  stroke: rgb(135 147 159 / 18%);
  stroke-width: 1;
  vector-effect: non-scaling-stroke;
}

#waz-cpu-chart-line,
#waz-network-rx-line,
#waz-network-tx-line {
  fill: none;
  stroke: var(--waz-cyan);
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
  vector-effect: non-scaling-stroke;
}

#waz-network-tx-line { stroke: var(--waz-violet); }

.waz-network-key i {
  display: inline-block;
  width: .42rem;
  height: .42rem;
  margin-right: .18rem;
  border-radius: 50%;
  background: var(--waz-cyan);
}

.waz-network-key i:nth-of-type(2) {
  margin-left: .42rem;
  background: var(--waz-violet);
}

.waz-core-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: .34rem;
  margin-top: .55rem;
}

.waz-core {
  min-width: 0;
  padding: .38rem .44rem;
  border: 1px solid rgb(135 147 159 / 16%);
  background: var(--waz-raised);
}

.waz-core-head {
  display: flex;
  justify-content: space-between;
  gap: .4rem;
  margin-bottom: .24rem;
  color: var(--waz-muted);
  font-size: .65rem;
  text-transform: uppercase;
}

.waz-thread {
  display: grid;
  grid-template-columns: 2.25rem minmax(0, 1fr) 2.2rem;
  align-items: center;
  gap: .3rem;
  font-size: .68rem;
  line-height: 1.45;
}

.waz-thread > b {
  overflow: hidden;
  color: var(--waz-text);
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waz-thread > em {
  color: var(--waz-cyan);
  font-style: normal;
  text-align: right;
}

.waz-mini-meter,
.waz-meter {
  overflow: hidden;
  background: #0b0d0f;
}

.waz-mini-meter { height: 4px; }
.waz-meter { height: 6px; margin-top: .55rem; }

.waz-mini-meter i,
.waz-meter i {
  display: block;
  width: 0;
  height: 100%;
  background: var(--waz-cyan);
  transition: width .55s ease-out;
}

.waz-detail-line,
.waz-member {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: .5rem;
  margin-top: .34rem;
  color: var(--waz-muted);
  font-size: .7rem;
}

.waz-memory-block .waz-meter i { background: var(--waz-cyan); }

.waz-resource-row {
  margin-top: 7px;
}

.waz-resource-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  color: var(--waz-muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .055em;
  line-height: 13px;
}

.waz-resource-head span {
  color: var(--waz-cyan);
  font-size: 11.5px;
  letter-spacing: 0;
}

.waz-resource-row .waz-meter {
  margin-top: 4px;
}

.waz-resource-row .waz-detail-line {
  margin-top: 3px;
}

.waz-network-chart-wrap { height: 62px; }

.waz-member-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: .35rem;
  margin-top: .42rem;
}

.waz-member {
  margin: 0;
  padding: .35rem .42rem;
  background: var(--waz-raised);
}

.waz-member b { color: var(--waz-text); }
.waz-member span { white-space: nowrap; }

.waz-state-dot {
  display: inline-block;
  width: .42rem;
  height: .42rem;
  margin-right: .25rem;
  border-radius: 50%;
  background: var(--waz-green);
}

.waz-state-dot.waz-down { background: var(--waz-red); }

.waz-system-footer {
  display: flex;
  justify-content: space-between;
  gap: .5rem;
  padding: .48rem .08rem 0;
  color: var(--waz-muted);
  font-size: .62rem;
  letter-spacing: .02em;
}

.waz-muted { color: var(--waz-muted); }

/* Unraid's dashboard uses a reduced root font size. Keep this panel readable
   with an explicit pixel scale while it remains inside one native column. */
#waz-system-tile .tile-header-main {
  font-size: 15px;
  line-height: 18px;
}

#waz-system-tile .section > span {
  font-size: 11px;
  line-height: 15px;
}

.waz-freshness {
  gap: 5px;
  font-size: 9px;
}

.waz-freshness i {
  width: 6px;
  height: 6px;
}

.waz-summary-cell {
  padding: 9px 11px;
}

.waz-summary-cell span,
.waz-block-header b {
  font-size: 9px;
  line-height: 12px;
}

.waz-summary-cell strong {
  margin-top: 3px;
  font-size: 14px;
  line-height: 17px;
}

.waz-block {
  margin-top: 12px;
  padding: 10px;
}

.waz-block-header {
  gap: 10px;
}

.waz-block-header small {
  margin-top: 3px;
  font-size: 11px;
  line-height: 15px;
}

.waz-block-header > strong {
  font-size: 16px;
  line-height: 19px;
}

.waz-chart-wrap {
  height: 106px;
  margin-top: 8px;
}

.waz-network-chart-wrap {
  height: 82px;
  margin-top: 8px;
}

.waz-chart-wrap > span,
.waz-network-key {
  top: 5px;
  left: 6px;
  font-size: 9px;
}

.waz-network-key i {
  width: 6px;
  height: 6px;
}

.waz-core-list {
  gap: 6px;
  margin-top: 8px;
}

.waz-core {
  padding: 6px 7px;
}

.waz-core-head {
  gap: 6px;
  margin-bottom: 4px;
  font-size: 9px;
  line-height: 12px;
}

.waz-thread {
  grid-template-columns: 38px minmax(0, 1fr) 35px;
  gap: 5px;
  font-size: 10.5px;
  line-height: 18px;
}

.waz-mini-meter { height: 5px; }
.waz-meter { height: 7px; margin-top: 8px; }

.waz-detail-line,
.waz-member {
  gap: 8px;
  margin-top: 6px;
  font-size: 10.5px;
  line-height: 15px;
}

.waz-member-list {
  gap: 6px;
  margin-top: 7px;
}

.waz-member {
  padding: 6px 7px;
}

.waz-state-dot {
  width: 6px;
  height: 6px;
  margin-right: 4px;
}

.waz-system-footer {
  gap: 8px;
  padding: 8px 2px 0;
  font-size: 9px;
  line-height: 12px;
}

/* Compact one-screen layout. The status board owns headline telemetry and the
   sections below provide detail without repeating the same large values. */
.waz-summary {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.waz-summary-cell {
  padding: 7px 9px;
}

.waz-summary-cell strong {
  font-size: 15px;
  line-height: 18px;
}

.waz-summary-cell small {
  display: block;
  margin-top: 2px;
  overflow: hidden;
  color: var(--waz-muted);
  font-size: 10px;
  line-height: 13px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waz-summary-cell > span,
.waz-block-header b {
  font-size: 11px;
  line-height: 14px;
}

.waz-block-header small {
  font-size: 12px;
  line-height: 16px;
}

.waz-chart-wrap > span,
.waz-network-key {
  font-size: 10px;
}

.waz-block {
  margin-top: 8px;
  padding: 8px;
}

.waz-chart-wrap {
  height: 70px;
  margin-top: 6px;
}

.waz-network-chart-wrap {
  height: 54px;
  margin-top: 6px;
}

.waz-core-list {
  gap: 4px;
  margin-top: 6px;
}

.waz-core {
  padding: 5px 6px;
}

.waz-core-head {
  margin-bottom: 2px;
  font-size: 10px;
  line-height: 12px;
}

.waz-thread {
  font-size: 11.5px;
  line-height: 17px;
}

.waz-meter {
  margin-top: 6px;
}

.waz-detail-line,
.waz-member {
  margin-top: 4px;
  font-size: 11.5px;
  line-height: 16px;
}

.waz-member-list {
  margin-top: 5px;
}

.waz-member {
  padding: 5px 6px;
}

.waz-system-footer {
  align-items: center;
  padding-top: 6px;
}

.waz-system-footer {
  font-size: 10px;
  line-height: 13px;
}

@media (max-width: 520px) {
  .waz-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .waz-core-list { grid-template-columns: 1fr; }
}


]]>
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/waz.dashboard/assets/css/workloads.css">
<INLINE>
<![CDATA[
#waz-workloads-tile {
  --waz-bg: #111417;
  --waz-panel: #1b2025;
  --waz-raised: #22282e;
  --waz-border: #303840;
  --waz-text: #e6edf3;
  --waz-muted: #87939f;
  --waz-cyan: #22b8f0;
  --waz-teal: #2dd4bf;
  --waz-green: #35c46a;
  --waz-amber: #f2a900;
  --waz-red: #e55454;
  --waz-violet: #a78bfa;
  color: var(--waz-text);
}

#waz-workloads-tile > tr > td {
  background: var(--waz-bg);
  border-color: var(--waz-border);
}

.waz-workloads,
.waz-workloads * { box-sizing: border-box; }

.waz-workloads {
  display: flex;
  min-height: 620px;
  flex-direction: column;
  overflow: hidden;
  color: var(--waz-text);
  font-variant-numeric: tabular-nums;
}

.waz-workloads-header,
.waz-workloads-section-head,
.waz-workloads-footer,
.waz-inspector-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.waz-workloads-header { padding: 2px 2px 8px; }

.waz-workloads-header b {
  display: block;
  font-size: 15px;
  line-height: 18px;
}

.waz-workloads-header small {
  display: block;
  margin-top: 2px;
  overflow: hidden;
  color: var(--waz-muted);
  font-size: 11px;
  line-height: 14px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waz-workloads-health {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: var(--waz-green);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .07em;
  white-space: nowrap;
}

.waz-workloads-health i,
.waz-container-state {
  display: inline-block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
}

.waz-workloads-health.waz-is-loading { color: var(--waz-muted); }
.waz-workloads-health.waz-is-attention { color: var(--waz-amber); }
.waz-workloads-health.waz-is-fault { color: var(--waz-red); }

.waz-workloads-alert {
  margin-bottom: 8px;
  padding: 6px 8px;
  border: 1px solid rgb(242 169 0 / 38%);
  border-left: 3px solid var(--waz-amber);
  background: rgb(242 169 0 / 8%);
  color: #f4c658;
  font-size: 10.5px;
  font-weight: 700;
  line-height: 14px;
}

.waz-workloads-alert.waz-is-fault {
  border-color: rgb(229 84 84 / 42%);
  border-left-color: var(--waz-red);
  background: rgb(229 84 84 / 8%);
  color: #f08080;
}

.waz-workloads-alert[hidden] { display: none; }

.waz-workloads-summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1px;
  padding: 1px;
  border: 1px solid var(--waz-border);
  background: var(--waz-border);
}

.waz-workloads-summary > div {
  min-width: 0;
  padding: 7px 8px;
  background: var(--waz-panel);
}

.waz-workloads-summary span,
.waz-workloads-section-head b,
.waz-selected-metrics span,
.waz-selected-detail-grid b {
  display: block;
  color: var(--waz-muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .07em;
  line-height: 13px;
}

.waz-workloads-summary strong {
  display: block;
  margin-top: 2px;
  overflow: hidden;
  color: var(--waz-cyan);
  font-size: 15px;
  line-height: 18px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waz-workloads-summary > div:nth-child(2) strong { color: var(--waz-green); }
.waz-workloads-summary > div:nth-child(3) strong { color: var(--waz-amber); }
.waz-workloads-summary > div:nth-child(4) strong { color: var(--waz-violet); }

.waz-workloads-section {
  margin-top: 8px;
  padding: 8px;
  border: 1px solid var(--waz-border);
  background: var(--waz-panel);
}

.waz-workloads-section-head { min-height: 14px; }

.waz-workloads-section-head > span {
  color: var(--waz-cyan);
  font-size: 10px;
  font-weight: 700;
  line-height: 13px;
}

.waz-folder-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 5px;
  margin-top: 6px;
}

.waz-folder-tab {
  position: relative;
  display: grid;
  min-width: 0;
  min-height: 43px;
  grid-template-columns: 27px minmax(0, 1fr);
  align-items: center;
  gap: 6px;
  padding: 5px 6px;
  overflow: hidden;
  border: 1px solid #34566b;
  background: var(--waz-raised);
  color: var(--waz-text);
  cursor: pointer;
  font: inherit;
  text-align: left;
}

.waz-folder-tab::before {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 2px;
  content: '';
  background: var(--folder-color, var(--waz-cyan));
}

.waz-folder-tab:hover,
.waz-folder-tab.waz-selected { border-color: var(--waz-cyan); }

.waz-folder-tab img,
.waz-folder-fallback {
  width: 25px;
  height: 25px;
  object-fit: contain;
}

.waz-folder-fallback {
  display: grid;
  place-items: center;
  color: var(--folder-color, var(--waz-cyan));
  font-size: 20px;
}

.waz-folder-tab b,
.waz-folder-tab small {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waz-folder-tab b { font-size: 10.5px; line-height: 13px; }
.waz-folder-tab small { color: var(--waz-muted); font-size: 9px; line-height: 12px; }

.waz-container-section {
  display: flex;
  min-height: 112px;
  flex: 1 1 180px;
  flex-direction: column;
}

.waz-container-grid {
  display: grid;
  min-height: 0;
  flex: 1 1 auto;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  grid-auto-rows: minmax(74px, auto);
  align-content: start;
  gap: 6px;
  margin-top: 6px;
  overflow: auto;
  scrollbar-width: thin;
}

.waz-container-card {
  position: relative;
  min-width: 0;
  min-height: 62px;
  padding: 5px 4px 4px;
  border: 1px solid rgb(135 147 159 / 17%);
  background: var(--waz-raised);
  cursor: pointer;
  text-align: center;
}

.waz-container-card:hover,
.waz-container-card.waz-selected { border-color: var(--waz-cyan); }
.waz-container-card.waz-selected { box-shadow: inset 0 0 0 1px rgb(34 184 240 / 25%); }

.waz-container-icon {
  position: relative;
  display: inline-block;
  width: 34px;
  height: 34px;
}

.waz-container-icon img {
  width: 34px;
  height: 34px;
  object-fit: contain;
}

.waz-container-card.waz-stopped .waz-container-icon img { filter: grayscale(1); opacity: .52; }

.waz-container-state {
  position: absolute;
  right: -2px;
  bottom: 0;
  color: var(--waz-green);
  box-shadow: 0 0 0 2px var(--waz-raised);
}

.waz-container-card.waz-paused .waz-container-state { color: var(--waz-amber); }
.waz-container-card.waz-stopped .waz-container-state,
.waz-container-card.waz-unhealthy .waz-container-state { color: var(--waz-red); }

.waz-container-card b {
  display: block;
  margin-top: 2px;
  overflow: hidden;
  color: var(--waz-text);
  font-size: 9.5px;
  line-height: 12px;
  overflow-wrap: anywhere;
  text-overflow: clip;
  white-space: normal;
  word-break: break-word;
}

.waz-container-badges {
  position: absolute;
  top: 3px;
  right: 3px;
  display: grid;
  gap: 2px;
  color: var(--waz-violet);
  font-size: 8px;
}

.waz-container-badges .waz-update { color: var(--waz-amber); }

.waz-process-head,
.waz-process-row {
  display: grid;
  grid-template-columns: minmax(0, 1.3fr) minmax(70px, .85fr) 42px 42px;
  align-items: center;
  gap: 6px;
}

.waz-process-head {
  margin-top: 5px;
  color: var(--waz-muted);
  font-size: 8.5px;
  font-weight: 700;
  letter-spacing: .06em;
}

.waz-process-row {
  min-height: 22px;
  margin-top: 3px;
  padding: 3px 5px;
  background: var(--waz-raised);
  font-size: 10px;
  line-height: 13px;
}

.waz-process-row span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waz-process-row .waz-process-owner { color: var(--waz-muted); }
.waz-process-row .waz-process-cpu { color: var(--waz-cyan); text-align: right; }
.waz-process-row .waz-process-memory { color: var(--waz-violet); text-align: right; }

.waz-inspector-section { flex: 0 0 auto; }

.waz-inspector-header {
  justify-content: flex-start;
  min-height: 35px;
}

.waz-selected-icon {
  display: grid;
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  place-items: center;
  color: var(--waz-cyan);
  font-size: 22px;
}

.waz-selected-icon img { width: 32px; height: 32px; object-fit: contain; }

.waz-inspector-title { min-width: 0; flex: 1 1 auto; }
.waz-inspector-title b,
.waz-inspector-title small {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.waz-inspector-title b { font-size: 12px; line-height: 15px; }
.waz-inspector-title small { color: var(--waz-muted); font-size: 9.5px; line-height: 12px; }

.waz-selected-badge {
  flex: 0 0 auto;
  color: var(--waz-muted);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .06em;
}
.waz-selected-badge.waz-running { color: var(--waz-green); }
.waz-selected-badge.waz-paused { color: var(--waz-amber); }
.waz-selected-badge.waz-stopped,
.waz-selected-badge.waz-unhealthy { color: var(--waz-red); }

.waz-selected-metrics {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 1px;
  margin-top: 6px;
  padding: 1px;
  background: var(--waz-border);
}

.waz-selected-metrics > div { min-width: 0; padding: 5px 6px; background: var(--waz-raised); }
.waz-selected-metrics strong {
  display: block;
  margin-top: 1px;
  overflow: hidden;
  color: var(--waz-cyan);
  font-size: 11px;
  line-height: 14px;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.waz-selected-metrics > div:nth-child(2) strong,
.waz-selected-metrics > div:nth-child(5) strong { color: var(--waz-violet); }

.waz-selected-charts {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 5px;
  margin-top: 6px;
}

.waz-selected-charts > div {
  position: relative;
  height: 38px;
  overflow: hidden;
  border: 1px solid rgb(135 147 159 / 16%);
  background: var(--waz-bg);
}

.waz-selected-charts span {
  position: absolute;
  z-index: 1;
  top: 2px;
  left: 4px;
  color: var(--waz-muted);
  font-size: 7.5px;
  font-weight: 700;
}

.waz-selected-charts svg { width: 100%; height: 100%; }
.waz-selected-charts polyline {
  fill: none;
  stroke: var(--waz-cyan);
  stroke-width: 1.6;
  stroke-linejoin: round;
  vector-effect: non-scaling-stroke;
}
.waz-selected-charts > div:nth-child(2) polyline { stroke: var(--waz-violet); }
.waz-selected-charts > div:nth-child(3) polyline { stroke: var(--waz-teal); }

.waz-selected-detail-grid {
  display: grid;
  grid-template-columns: 1.1fr 1fr 1.25fr;
  gap: 5px;
  margin-top: 6px;
}

.waz-selected-detail-grid > div {
  min-width: 0;
  padding: 4px 5px;
  background: var(--waz-raised);
}

.waz-selected-detail-grid span {
  display: block;
  margin-top: 1px;
  overflow: hidden;
  color: var(--waz-text);
  font-size: 9px;
  line-height: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waz-workloads-footer {
  padding: 6px 2px 0;
  color: var(--waz-muted);
  font-size: 10px;
  line-height: 13px;
}

.waz-workloads-muted { color: var(--waz-muted); font-size: 10px; }

@media (max-width: 620px) {
  .waz-workloads { height: auto !important; overflow: visible; }
  .waz-workloads-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .waz-folder-tabs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .waz-container-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); max-height: none; }
  .waz-selected-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .waz-selected-detail-grid { grid-template-columns: 1fr; }
}


]]>
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/waz.dashboard/assets/js/banner.js">
<INLINE>
<![CDATA[
(function () {
  "use strict";

  if (window.WAZHealth && window.WAZHealth.version) return;

  var config = window.WAZHealthBootstrap || {};
  var endpoint = config.endpoint || "/plugins/waz.dashboard/include/status.php";
  var fanEndpoint = config.fanEndpoint || "/plugins/waz.dashboard/include/md1200-control.php";
  // Unraid publishes the current session token as a page-global variable.
  var csrfToken = String(window.csrf_token || config.csrfToken || "");
  var refreshMs = Math.max(3000, Number(config.refreshMs) || 5000);
  var allowedStates = ["normal", "attention", "fault", "unknown"];
  var subsystemOrder = ["array", "storage", "cooling", "ups"];
  var state = {
    server: { label: "WAZ-SERVER", uptimeSeconds: null },
    overall: { label: "SYSTEM NORMAL", state: "normal", message: "" },
    subsystems: {},
    fans: { enabled: false, mode: "auto", manualSpeed: 20, healthState: "normal", shelves: [] },
    uptimeSampledAt: Date.now()
  };
  var banner = null;
  var refreshTimer = null;
  var clockTimer = null;
  var resizeObserver = null;
  var fanBusy = false;

  function normalizeState(value) {
    value = String(value || "unknown").toLowerCase();
    return allowedStates.indexOf(value) >= 0 ? value : "unknown";
  }

  function escapeText(value) {
    return String(value == null ? "" : value);
  }

  function formatUptime(seconds) {
    if (!Number.isFinite(seconds) || seconds < 0) return "—";
    var totalMinutes = Math.floor(seconds / 60);
    var days = Math.floor(totalMinutes / 1440);
    var hours = Math.floor((totalMinutes % 1440) / 60);
    var minutes = totalMinutes % 60;
    if (days > 0) return days + "d " + hours + "h";
    if (hours > 0) return hours + "h " + minutes + "m";
    return minutes + "m";
  }

  function localTime() {
    return new Intl.DateTimeFormat(undefined, {
      hour: "numeric",
      minute: "2-digit"
    }).format(new Date());
  }

  function createIndicator(key, label) {
    var item = document.createElement("span");
    item.className = "waz-health__subsystem";
    item.dataset.subsystem = key;

    var name = document.createElement("span");
    name.className = "waz-health__subsystem-label";
    name.textContent = label;

    var dot = document.createElement("span");
    dot.className = "waz-health__dot";
    dot.setAttribute("aria-hidden", "true");

    item.appendChild(name);
    item.appendChild(dot);
    return item;
  }

  function setFanMode(value) {
    if (fanBusy || !state.fans.enabled) return;
    var manual = value !== "auto";
    var speed = manual ? Number(value) : Number(state.fans.manualSpeed || 20);
    var prompt = manual
      ? "Set both MD1200 shelves to " + speed + "% manual fan speed?"
      : "Return both MD1200 shelves to automatic temperature control?";
    if (!window.confirm(prompt)) {
      renderFans();
      return;
    }

    fanBusy = true;
    renderFans();
    var body = new URLSearchParams();
    body.set("csrf_token", csrfToken);
    body.set("mode", manual ? "manual" : "auto");
    if (manual) body.set("speed", String(speed));
    fetch(fanEndpoint, {
      method: "POST",
      credentials: "same-origin",
      cache: "no-store",
      headers: { "Content-Type": "application/x-www-form-urlencoded", Accept: "application/json" },
      body: body.toString()
    })
      .then(function (response) {
        return response.json().then(function (payload) {
          if (!response.ok) throw new Error(payload.error || "Fan control update failed");
          state.fans = Object.assign({}, state.fans, payload);
        });
      })
      .catch(function (error) {
        window.alert(error.message || "Fan control update failed");
      })
      .finally(function () {
        fanBusy = false;
        renderFans();
        window.setTimeout(refresh, 1200);
      });
  }

  function createFanControl() {
    var control = document.createElement("span");
    control.className = "waz-health__fans";
    control.dataset.field = "fans";
    control.innerHTML = '<span class="waz-health__fans-label"><span class="waz-health__dot" aria-hidden="true"></span>MD1200</span>' +
      '<span class="waz-health__fan-readings"><span data-fan-shelf="top">TOP —</span><span data-fan-shelf="bottom">BOTTOM —</span></span>';

    var select = document.createElement("select");
    select.className = "waz-health__fan-select";
    select.setAttribute("aria-label", "MD1200 fan control mode and manual speed");
    [
      ["auto", "AUTO"],
      ["20", "MANUAL 20%"],
      ["30", "MANUAL 30%"],
      ["40", "MANUAL 40%"],
      ["50", "MANUAL 50%"]
    ].forEach(function (entry) {
      var option = document.createElement("option");
      option.value = entry[0];
      option.textContent = entry[1];
      select.appendChild(option);
    });
    select.addEventListener("change", function () { setFanMode(select.value); });
    control.appendChild(select);
    return control;
  }

  function createBanner() {
    var root = document.createElement("section");
    root.id = "waz-health-banner";
    root.className = "waz-health";
    root.setAttribute("role", "status");
    root.setAttribute("aria-live", "polite");
    root.setAttribute("aria-label", "WAZ server health");

    var inner = document.createElement("div");
    inner.className = "waz-health__inner";

    var identity = document.createElement("span");
    identity.className = "waz-health__identity";
    identity.dataset.field = "server";

    var overall = document.createElement("span");
    overall.className = "waz-health__overall";
    overall.innerHTML = '<span class="waz-health__dot" aria-hidden="true"></span><span data-field="overall">SYSTEM NORMAL</span>';

    var dividerOne = document.createElement("span");
    dividerOne.className = "waz-health__divider";
    dividerOne.setAttribute("aria-hidden", "true");

    var subsystems = document.createElement("span");
    subsystems.className = "waz-health__subsystems";
    subsystemOrder.forEach(function (key) {
      subsystems.appendChild(createIndicator(key, key.toUpperCase()));
    });

    var dividerTwo = dividerOne.cloneNode(true);

    var fanControl = createFanControl();

    var dividerThree = dividerOne.cloneNode(true);

    var meta = document.createElement("span");
    meta.className = "waz-health__meta";
    meta.innerHTML = '<time class="waz-health__time" data-field="time"></time><span class="waz-health__uptime"><span aria-hidden="true">↑</span><span data-field="uptime">—</span></span>';

    inner.appendChild(identity);
    inner.appendChild(overall);
    inner.appendChild(dividerOne);
    inner.appendChild(subsystems);
    inner.appendChild(dividerTwo);
    inner.appendChild(fanControl);
    inner.appendChild(dividerThree);
    inner.appendChild(meta);
    root.appendChild(inner);

    var issues = document.createElement("div");
    issues.className = "waz-health__issues";
    issues.dataset.field = "issues";
    issues.setAttribute("aria-label", "Active health details");
    root.appendChild(issues);
    return root;
  }

  function renderIssues() {
    if (!banner) return;
    var issuesNode = banner.querySelector('[data-field="issues"]');
    if (!issuesNode) return;

    var activeIssues = [];
    subsystemOrder.forEach(function (key) {
      var value = state.subsystems[key] || {};
      var issueState = normalizeState(value.state);
      if (issueState !== "attention" && issueState !== "fault") return;
      activeIssues.push({
        label: value.label || key.toUpperCase(),
        state: issueState,
        message: value.message || ((value.label || key.toUpperCase()) + " reported " + issueState)
      });
    });

    var overallState = normalizeState(state.overall.state);
    if (!activeIssues.length && (overallState === "attention" || overallState === "fault")) {
      activeIssues.push({
        label: state.overall.label || "SYSTEM",
        state: overallState,
        message: state.overall.message || "System health requires attention"
      });
    }

    activeIssues.sort(function (left, right) {
      var rank = { fault: 2, attention: 1 };
      return (rank[right.state] || 0) - (rank[left.state] || 0);
    });

    issuesNode.replaceChildren();
    activeIssues.forEach(function (issue) {
      var item = document.createElement("span");
      item.className = "waz-health__issue";
      item.dataset.state = issue.state;

      var dot = document.createElement("span");
      dot.className = "waz-health__dot";
      dot.setAttribute("aria-hidden", "true");

      var label = document.createElement("strong");
      label.textContent = issue.label;

      var message = document.createElement("span");
      message.textContent = issue.message;

      item.appendChild(dot);
      item.appendChild(label);
      item.appendChild(message);
      issuesNode.appendChild(item);
    });

    banner.classList.toggle("waz-health--expanded", activeIssues.length > 0);
  }

  function updateClockAndUptime() {
    if (!banner) return;
    var timeNode = banner.querySelector('[data-field="time"]');
    var uptimeNode = banner.querySelector('[data-field="uptime"]');
    if (timeNode) {
      timeNode.textContent = localTime();
      timeNode.setAttribute("datetime", new Date().toISOString());
    }
    if (uptimeNode) {
      var elapsed = Math.max(0, (Date.now() - state.uptimeSampledAt) / 1000);
      var seconds = Number(state.server.uptimeSeconds);
      uptimeNode.textContent = formatUptime(Number.isFinite(seconds) ? seconds + elapsed : NaN);
    }
  }

  function render() {
    if (!banner) return;
    var serverNode = banner.querySelector('[data-field="server"]');
    var overallNode = banner.querySelector('[data-field="overall"]');
    var overall = banner.querySelector(".waz-health__overall");

    if (serverNode) serverNode.textContent = escapeText(state.server.label || "WAZ-SERVER");
    if (overallNode) overallNode.textContent = escapeText(state.overall.label || "STATUS UNKNOWN");
    if (overall) overall.dataset.state = normalizeState(state.overall.state);

    subsystemOrder.forEach(function (key) {
      var item = banner.querySelector('[data-subsystem="' + key + '"]');
      var value = state.subsystems[key] || { label: key.toUpperCase(), state: "unknown" };
      if (!item) return;
      item.dataset.state = normalizeState(value.state);
      var label = item.querySelector(".waz-health__subsystem-label");
      if (label) label.textContent = escapeText(value.label || key.toUpperCase());
      item.setAttribute("aria-label", (value.label || key) + ": " + normalizeState(value.state));
    });

    renderFans();

    renderIssues();
    updateClockAndUptime();
  }

  function renderFans() {
    if (!banner) return;
    var control = banner.querySelector('[data-field="fans"]');
    if (!control) return;
    var fans = state.fans || {};
    var enabled = fans.enabled === true;
    var mode = fans.mode === "manual" ? "manual" : "auto";
    var select = control.querySelector("select");
    var readings = control.querySelector(".waz-health__fan-readings");
    control.dataset.state = enabled ? normalizeState(fans.healthState || "unknown") : "unknown";
    control.classList.toggle("waz-health__fans--disabled", !enabled);
    control.classList.toggle("waz-health__fans--manual", mode === "manual");
    if (select) {
      select.value = mode === "manual" ? String(fans.manualSpeed || 20) : "auto";
      select.disabled = !enabled || fanBusy;
      select.title = enabled ? "Controls both MD1200 shelves" : "Controller is staged but not enabled";
    }
    if (readings) readings.hidden = mode !== "auto";

    ["top", "bottom"].forEach(function (id) {
      var node = control.querySelector('[data-fan-shelf="' + id + '"]');
      if (!node) return;
      var shelf = (fans.shelves || []).find(function (item) { return item.id === id; }) || {};
      var rpm = Number(shelf.averageRpm);
      node.textContent = id.toUpperCase() + " " + (Number.isFinite(rpm) && rpm > 0 ? Math.round(rpm) + " RPM" : "—");
      node.title = [
        shelf.name || ("MD1200 " + id),
        shelf.temperatureC == null ? "temperature unavailable" : shelf.temperatureC + "°C from " + (shelf.temperatureSource || "assigned disks"),
        shelf.targetPercent == null ? "target unavailable" : shelf.targetPercent + "% target",
        shelf.telemetryMessage || "fan telemetry current"
      ].join(" · ");
    });
    control.setAttribute("aria-label", enabled
      ? "MD1200 fan control: " + mode + (mode === "manual" ? " at " + fans.manualSpeed + " percent" : "")
      : "MD1200 fan control is staged but disabled");
  }

  function mergeSnapshot(next) {
    if (!next || typeof next !== "object") return;
    if (next.server && typeof next.server === "object") {
      state.server = Object.assign({}, state.server, next.server);
      if (next.server.uptimeSeconds != null) state.uptimeSampledAt = Date.now();
    }
    if (next.overall && typeof next.overall === "object") {
      state.overall = Object.assign({}, state.overall, next.overall);
    }
    if (next.subsystems && typeof next.subsystems === "object") {
      state.subsystems = Object.assign({}, state.subsystems, next.subsystems);
    }
    if (next.fans && typeof next.fans === "object") {
      state.fans = Object.assign({}, state.fans, next.fans);
    }
    render();
  }

  function refresh() {
    return fetch(endpoint, {
      credentials: "same-origin",
      cache: "no-store",
      headers: { Accept: "application/json" }
    })
      .then(function (response) {
        if (!response.ok) throw new Error("WAZ Health endpoint returned " + response.status);
        return response.json();
      })
      .then(function (snapshot) {
        mergeSnapshot(snapshot);
        if (banner) banner.dataset.connection = "online";
        return snapshot;
      })
      .catch(function (error) {
        if (banner) banner.dataset.connection = "offline";
        if (window.console && console.debug) console.debug("WAZ Health refresh failed", error);
        return null;
      });
  }

  function updateStickyOffset(menu) {
    if (!banner || !menu) return;
    var style = window.getComputedStyle(menu);
    var navIsTopSticky = style.position === "sticky" && document.documentElement.classList.contains("Theme--nav-top");
    banner.style.setProperty("--waz-health-sticky-top", navIsTopSticky ? menu.offsetHeight + "px" : "0px");
  }

  function mount() {
    if (document.getElementById("waz-health-banner")) {
      banner = document.getElementById("waz-health-banner");
      return;
    }

    var menu = document.getElementById("menu");
    var display = document.getElementById("displaybox");
    banner = createBanner();

    if (menu && menu.parentNode) {
      menu.insertAdjacentElement("afterend", banner);
      updateStickyOffset(menu);
      if (window.ResizeObserver) {
        resizeObserver = new ResizeObserver(function () { updateStickyOffset(menu); });
        resizeObserver.observe(menu);
      } else {
        window.addEventListener("resize", function () { updateStickyOffset(menu); });
      }
    } else if (display && display.parentNode) {
      display.parentNode.insertBefore(banner, display);
    } else {
      document.body.insertBefore(banner, document.body.firstChild);
    }

    render();
    refresh();
    refreshTimer = window.setInterval(refresh, refreshMs);
    clockTimer = window.setInterval(updateClockAndUptime, 60000);
  }

  window.WAZHealth = {
    version: "0.8.0",
    refresh: refresh,
    setState: function (next) {
      mergeSnapshot(next);
      return JSON.parse(JSON.stringify(state));
    },
    getState: function () {
      return JSON.parse(JSON.stringify(state));
    },
    destroy: function () {
      if (refreshTimer) window.clearInterval(refreshTimer);
      if (clockTimer) window.clearInterval(clockTimer);
      if (resizeObserver) resizeObserver.disconnect();
      if (banner && banner.parentNode) banner.parentNode.removeChild(banner);
      banner = null;
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", mount, { once: true });
  } else {
    mount();
  }
})();

]]>
</INLINE>
