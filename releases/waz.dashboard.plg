</FILE>

<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
set -e

RUNTIME_DIR="/usr/local/emhttp/plugins/waz.dashboard"
CONFIG_DIR="/boot/config/plugins/waz.dashboard"
CONFIG_FILE="$CONFIG_DIR/waz.dashboard.cfg"
LEGACY_HEALTH_CONFIG="/boot/config/plugins/waz.health/waz.health.cfg"
LEGACY_HEALTH_PLUGIN="/boot/config/plugins/waz.health.plg"

chmod 0644 "$RUNTIME_DIR/WazDashboard.page" "$RUNTIME_DIR/WazWorkloads.page" "$RUNTIME_DIR/WazStorage.page" "$RUNTIME_DIR/WazHealthBanner.page"
chmod 0644 "$RUNTIME_DIR/assets/css/system.css" "$RUNTIME_DIR/assets/css/workloads.css" "$RUNTIME_DIR/assets/css/storage.css" "$RUNTIME_DIR/assets/css/banner.css"
chmod 0644 "$RUNTIME_DIR/assets/js/system.js" "$RUNTIME_DIR/assets/js/workloads.js" "$RUNTIME_DIR/assets/js/storage.js" "$RUNTIME_DIR/assets/js/banner.js"
chmod 0644 "$RUNTIME_DIR/include/metrics.php" "$RUNTIME_DIR/include/workloads.php" "$RUNTIME_DIR/include/storage.php" "$RUNTIME_DIR/include/gpu-sampler.php" "$RUNTIME_DIR/include/health.php" "$RUNTIME_DIR/include/status.php" "$RUNTIME_DIR/include/md1200.php" "$RUNTIME_DIR/include/md1200-control.php" "$RUNTIME_DIR/include/md1200-controller.php"
chmod 0755 "$RUNTIME_DIR/scripts/start.sh" "$RUNTIME_DIR/scripts/stop.sh" "$RUNTIME_DIR/scripts/backup-md1200.sh" "$RUNTIME_DIR/scripts/diagnose-md1200.sh" "$RUNTIME_DIR/scripts/test-md1200-controls.sh"

php -l "$RUNTIME_DIR/include/metrics.php" >/dev/null
php -l "$RUNTIME_DIR/include/workloads.php" >/dev/null
php -l "$RUNTIME_DIR/include/storage.php" >/dev/null
php -l "$RUNTIME_DIR/include/gpu-sampler.php" >/dev/null
php -l "$RUNTIME_DIR/include/health.php" >/dev/null
php -l "$RUNTIME_DIR/include/status.php" >/dev/null
php -l "$RUNTIME_DIR/include/md1200.php" >/dev/null
php -l "$RUNTIME_DIR/include/md1200-control.php" >/dev/null
php -l "$RUNTIME_DIR/include/md1200-controller.php" >/dev/null

if [ ! -f "$CONFIG_FILE" ]; then
  cat > "$CONFIG_FILE" <<'WAZ_CONFIG'
DISPLAY_NAME="WAZ-SERVER"
PRIMARY_INTERFACE="bond0"
GPU_CARD="auto"
GPU_RECENT_SECONDS="5"
OVERALL_STATE="normal"
OVERALL_MESSAGE=""
ARRAY_STATE="normal"
ARRAY_MESSAGE=""
STORAGE_STATE="normal"
STORAGE_MESSAGE=""
COOLING_STATE="normal"
COOLING_MESSAGE=""
UPS_STATE="normal"
UPS_MESSAGE=""
STORAGE_WARN_PERCENT="95"
STORAGE_FAULT_PERCENT="98"
CPU_WARN_C="60"
CPU_FAULT_C="70"
COOLANT_WARN_C="35"
COOLANT_FAULT_C="40"
FLOW_WARN_LPH="130"
FLOW_FAULT_LPH="120"
THROTTLE_LATCH_SECONDS="300"
UPS_LOAD_WARN_PERCENT="90"
UPS_LOAD_FAULT_PERCENT="100"
MD1200_ENABLED="no"
MD1200_MODE="auto"
MD1200_MANUAL_SPEED="20"
MD1200_POLL_SECONDS="30"
MD1200_REASSERT_SECONDS="900"
MD1200_SENSOR_FAILURE_SPEED="50"
MD1200_HYSTERESIS_C="1"
MD1200_THRESHOLD_WARM_C="35"
MD1200_THRESHOLD_HOT_C="45"
MD1200_THRESHOLD_VERY_HOT_C="50"
MD1200_SPEED_COOL="20"
MD1200_SPEED_WARM="25"
MD1200_SPEED_HOT="30"
MD1200_SPEED_VERY_HOT="50"
MD1200_TOP_NAME="MD1200 Top"
MD1200_TOP_PORT="/dev/serial/by-id/usb-FTDI_USB_Serial_Converter_FTE33O9T-if00-port0"
MD1200_TOP_SES_DEVICE="/dev/sg18"
MD1200_TOP_SES_ADDRESS="0:0:18:0"
MD1200_TOP_DISKS="disk1,disk2,disk3,disk4,parity,parity2"
MD1200_BOTTOM_NAME="MD1200 Bottom"
MD1200_BOTTOM_PORT="/dev/serial/by-id/usb-FTDI_USB_Serial_Converter_FTE32AB2-if00-port0"
MD1200_BOTTOM_SES_DEVICE="/dev/sg11"
MD1200_BOTTOM_SES_ADDRESS="0:0:11:0"
MD1200_BOTTOM_DISKS="disk5,disk6,disk7,disk8,disk9,disk10,disk11,disk12,disk13,disk14,disk15"
MD1200_BACKUP_DIR="/mnt/user/Back-Up/MD1200-Fan-Controller"
WAZ_CONFIG
fi

for DEFAULT in \
  'DISPLAY_NAME="WAZ-SERVER"' \
  'PRIMARY_INTERFACE="bond0"' \
  'GPU_CARD="auto"' \
  'GPU_RECENT_SECONDS="5"' \
  'OVERALL_STATE="normal"' \
  'OVERALL_MESSAGE=""' \
  'ARRAY_STATE="normal"' \
  'ARRAY_MESSAGE=""' \
  'STORAGE_STATE="normal"' \
  'STORAGE_MESSAGE=""' \
  'COOLING_STATE="normal"' \
  'COOLING_MESSAGE=""' \
  'UPS_STATE="normal"' \
  'UPS_MESSAGE=""' \
  'STORAGE_WARN_PERCENT="95"' \
  'STORAGE_FAULT_PERCENT="98"' \
  'CPU_WARN_C="60"' \
  'CPU_FAULT_C="70"' \
  'COOLANT_WARN_C="35"' \
  'COOLANT_FAULT_C="40"' \
  'FLOW_WARN_LPH="130"' \
  'FLOW_FAULT_LPH="120"' \
  'THROTTLE_LATCH_SECONDS="300"' \
  'UPS_LOAD_WARN_PERCENT="90"' \
  'UPS_LOAD_FAULT_PERCENT="100"' \
  'MD1200_ENABLED="no"' \
  'MD1200_MODE="auto"' \
  'MD1200_MANUAL_SPEED="20"' \
  'MD1200_POLL_SECONDS="30"' \
  'MD1200_REASSERT_SECONDS="900"' \
  'MD1200_SENSOR_FAILURE_SPEED="50"' \
  'MD1200_HYSTERESIS_C="1"' \
  'MD1200_THRESHOLD_WARM_C="35"' \
  'MD1200_THRESHOLD_HOT_C="45"' \
  'MD1200_THRESHOLD_VERY_HOT_C="50"' \
  'MD1200_SPEED_COOL="20"' \
  'MD1200_SPEED_WARM="25"' \
  'MD1200_SPEED_HOT="30"' \
  'MD1200_SPEED_VERY_HOT="50"' \
  'MD1200_TOP_NAME="MD1200 Top"' \
  'MD1200_TOP_PORT="/dev/serial/by-id/usb-FTDI_USB_Serial_Converter_FTE33O9T-if00-port0"' \
  'MD1200_TOP_SES_DEVICE="/dev/sg18"' \
  'MD1200_TOP_SES_ADDRESS="0:0:18:0"' \
  'MD1200_TOP_DISKS="disk1,disk2,disk3,disk4,parity,parity2"' \
  'MD1200_BOTTOM_NAME="MD1200 Bottom"' \
  'MD1200_BOTTOM_PORT="/dev/serial/by-id/usb-FTDI_USB_Serial_Converter_FTE32AB2-if00-port0"' \
  'MD1200_BOTTOM_SES_DEVICE="/dev/sg11"' \
  'MD1200_BOTTOM_SES_ADDRESS="0:0:11:0"' \
  'MD1200_BOTTOM_DISKS="disk5,disk6,disk7,disk8,disk9,disk10,disk11,disk12,disk13,disk14,disk15"' \
  'MD1200_BACKUP_DIR="/mnt/user/Back-Up/MD1200-Fan-Controller"'; do
  KEY="${DEFAULT%%=*}"
  if ! grep -q "^${KEY}=" "$CONFIG_FILE"; then
    LEGACY_VALUE=""
    if [ -f "$LEGACY_HEALTH_CONFIG" ]; then
      LEGACY_VALUE="$(grep -m1 "^${KEY}=" "$LEGACY_HEALTH_CONFIG" 2>/dev/null || true)"
    fi
    printf '%s\n' "${LEGACY_VALUE:-$DEFAULT}" >> "$CONFIG_FILE"
  fi
done

chmod 0644 "$CONFIG_FILE"
mkdir -p /var/run/waz.dashboard
rm -f "/var/tmp/waz-health-throttle-state.json"

if [ -f "$LEGACY_HEALTH_PLUGIN" ]; then
  mv -f "$LEGACY_HEALTH_PLUGIN" "${LEGACY_HEALTH_PLUGIN}.disabled"
fi
rm -rf "/usr/local/emhttp/plugins/waz.health"

if [ ! -f "$CONFIG_DIR/md1200-migration-backed-up" ] && [ -d "/mnt/user/Back-Up" ]; then
  if "$RUNTIME_DIR/scripts/backup-md1200.sh" >/dev/null; then
    touch "$CONFIG_DIR/md1200-migration-backed-up"
  fi
fi

"$RUNTIME_DIR/scripts/start.sh"

echo "WAZ Dashboard v0.8.0 installed with integrated Health banner. Reload the Unraid WebUI to display it."
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
RUNTIME_DIR="/usr/local/emhttp/plugins/waz.dashboard"

if [ -x "$RUNTIME_DIR/scripts/stop.sh" ]; then
  "$RUNTIME_DIR/scripts/stop.sh" || true
fi
if [ -x "$RUNTIME_DIR/scripts/backup-md1200.sh" ]; then
  "$RUNTIME_DIR/scripts/backup-md1200.sh" >/dev/null || true
fi
rm -rf "$RUNTIME_DIR"
rm -rf "/var/run/waz.dashboard"
rm -f "/boot/config/plugins/waz.dashboard.plg"
echo "WAZ System removed. Persistent settings were retained in /boot/config/plugins/waz.dashboard. Reload the Dashboard to clear the panel."
]]>
</INLINE>
</FILE>
</PLUGIN>
